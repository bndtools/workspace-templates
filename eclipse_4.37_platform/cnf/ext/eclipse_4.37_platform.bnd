# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.37 = 4.37
eclipse.platform.reltag.R-4.37-202509050730 = R-4.37-202509050730

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.p2.repository.4.37: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 Platform ${eclipse.platform.version.4.37}'; \
        url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.37}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.37}_platform_p2.index.xml.gz'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.osgi.repository.4.37: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse Platform ${eclipse.platform.version.4.37}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.37}_platform_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.37}'

# Exactly one is active: p2 repository if useIndexed is false, OSGi indexed repository if true (see eclipse-repo-config.bnd).
-plugin.p2.eclipse.platform_4.37: ${if;${useIndexed};;${eclipse.p2.repository.4.37}}
-plugin.osgi.eclipse.platform_4.37: ${if;${useIndexed};${eclipse.osgi.repository.4.37};}
