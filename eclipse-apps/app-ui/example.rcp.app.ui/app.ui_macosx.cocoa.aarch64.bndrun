-include: app.ui_shared.bndrun
-runvm: -XstartOnFirstThread
-runsystemcapabilities: osgi.native;osgi.native.osname:List<String>="macosx";osgi.native.processor:List<String>="aarch64"
-runproperties.platform: osgi.ws=cocoa,osgi.arch=aarch64,osgi.os=macosx
-runblacklist: osgi.identity;filter:='(|(osgi.identity=*linux*)(osgi.identity=*win32*)(osgi.identity=*x86_64*))'