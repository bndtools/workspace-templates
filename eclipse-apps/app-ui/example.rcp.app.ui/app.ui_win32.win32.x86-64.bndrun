-include: app.ui_shared.bndrun
-runsystemcapabilities: osgi.native;osgi.native.osname:List<String>="win32";osgi.native.processor:List<String>="x86-64"
-runproperties.platform: osgi.ws=win32,osgi.arch=x86_64,osgi.os=win32
-runblacklist: osgi.identity;filter:='(|(osgi.identity=*macosx*)(osgi.identity=*linux*)(osgi.identity=*aarch64*))'