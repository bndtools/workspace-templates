# Eclipse Platform Release repository
eclipse.technology.baseurl = https://download.eclipse.org/technology

version: 4.3.0
-plugin.eclipse-apps.swtbot: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name      = 'Eclipse SWTBot ${version} <P2>'; \
        url.      = '${eclipse.technology.baseurl}/swtbot/releases/${version}/'; \
        locations = '${fileuri;${.}/eclipse-swtbot-${version}-index.xml.gz'; \
        cache.    = '${build}/cache/ecl-swtbot-${version}'
