# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.35 = 4.35
eclipse.platform.reltag.R-4.35-202502280140 = R-4.35-202502280140

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.repo.4.35.p2: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse Platform ${eclipse.platform.version.4.35} <P2>'; \
        url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.35}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.35}_platform_p2.index.xml.gz'; \
        cache    = '${build}/cache/ecl_${eclipse.platform.version.4.35}'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.repo.4.35.osgi: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse Platform ${eclipse.platform.version.4.35} <OSGi>'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.35}_platform_p2.index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.35}'

# OSGiRepository requires the P2Repository index to be created first.
# indexed=false selects P2Repository andcreates the index from download.eclipse.org.
# indexed=true selects OSGiRepository anduses the generated *_p2.index.xml.gz.
indexed.ecl-4.35 = true

# Exactly one repository is active, selected by indexed.
-plugin.eclipse.repo.4.35.p2: ${if;${indexed.ecl-4.35};;${eclipse.repo.4.35.p2}}
-plugin.eclipse.repo.4.35.osgi: ${if;${indexed.ecl-4.35};${eclipse.repo.4.35.osgi};}
