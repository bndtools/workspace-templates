# Eclipse Simultaneous Release repository 
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.35      = 4.35
eclipse.simrel.version.2025-03     = 2025-03
eclipse.simrel.reltag.202503121000 = 202503121000

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.p2.repository.2025-03: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 SimRel ${eclipse.platform.version.4.35}/${eclipse.simrel.version.2025-03}'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2025-03}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.35}_simrel_${eclipse.simrel.version.2025-03}_p2.index.xml.gz'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.osgi.repository.2025-03: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.35}/${eclipse.simrel.version.2025-03}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.35}_simrel_${eclipse.simrel.version.2025-03}_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.35}'

# Exactly one is active: p2 repository if useIndexed is false, OSGi indexed repository if true (see eclipse-repo-config.bnd).
-plugin.p2.eclipse.simrel_2025-03: ${if;${useIndexed};;${eclipse.p2.repository.2025-03}}
-plugin.osgi.eclipse.simrel_2025-03: ${if;${useIndexed};${eclipse.osgi.repository.2025-03};}
