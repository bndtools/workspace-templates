# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.34 = 4.34
eclipse.platform.reltag.R-4.34-202411201800 = R-4.34-202411201800

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.repo.4.34.p2: \
    aQute.bnd.repository.p2.provider.P2Repository; \
    name     = 'Eclipse Platform ${eclipse.platform.version.4.34} <P2>'; \
    url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.34}'; \
    location = 'eclipse_${eclipse.platform.version.4.34}_platform_p2.index.xml.gz'; \
    cache    = '${build}/cache/ecl_${eclipse.platform.version.4.34}'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.repo.4.34.osgi: \
    aQute.bnd.repository.osgi.OSGiRepository; \
    name      = 'Eclipse Platform ${eclipse.platform.version.4.34} <OSGi>'; \
    locations = '${fileuri;eclipse_${eclipse.platform.version.4.34}_platform_p2.index.xml.gz}'; \
    cache     = '${build}/cache/ecl_${eclipse.platform.version.4.34}'

# OSGiRepository requires the P2Repository index to be created first.
# indexed=false selects P2Repository, which creates the index from download.eclipse.org.
# indexed=true selects OSGiRepository, which uses the generated *_p2.index.xml.gz.
indexed = false

# Exactly one repository is active, selected by indexed.
-plugin.eclipse.repo.4.34.p2: ${if;${indexed};;${eclipse.repo.4.34.p2}}
-plugin.eclipse.repo.4.34.osgi: ${if;${indexed};${eclipse.repo.4.34.osgi};}
