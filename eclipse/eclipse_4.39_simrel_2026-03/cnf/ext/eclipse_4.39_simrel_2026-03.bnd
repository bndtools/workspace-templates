# Eclipse Simultaneous Release repository 
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.39      = 4.39
eclipse.simrel.version.2026-03     = 2026-03
eclipse.simrel.reltag.202603111000 = 202603111000

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.p2.repository.2026-03: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 SimRel ${eclipse.platform.version.4.39}/${eclipse.simrel.version.2026-03}'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2026-03}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.39}_simrel_${eclipse.simrel.version.2026-03}_p2.index.xml.gz'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.osgi.repository.2026-03: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.39}/${eclipse.simrel.version.2026-03}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.39}_simrel_${eclipse.simrel.version.2026-03}_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.39}'

# Selects which repository type the eclipse_* file in this folder activates.
#   true  = OSGiRepository backed by the pre-generated *_p2.index.xml.gz (fast, no p2 metadata download)
#   false = P2Repository that reads the p2 site directly from download.eclipse.org
# The index is generated from the p2 repository (see 'location' in the eclipse_* file).
useIndexed = false

# Exactly one is active: p2 repository if useIndexed is false, OSGi indexed repository if true (see eclipse-repo-config.bnd).
-plugin.p2.eclipse.simrel_2026-03: ${if;${useIndexed};;${eclipse.p2.repository.2026-03}}
-plugin.osgi.eclipse.simrel_2026-03: ${if;${useIndexed};${eclipse.osgi.repository.2026-03};}
