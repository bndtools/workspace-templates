# Eclipse Simultaneous Release repository
eclipse.simrel.baseurl = https://download.eclipse.org/releases

eclipse.platform.version.4.31      = 4.31
eclipse.simrel.version.2024-03     = 2024-03
eclipse.simrel.reltag.202403131000 = 202403131000

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.repo.2024-03.p2: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse SimRel ${eclipse.platform.version.4.31}/${eclipse.simrel.version.2024-03} <P2>'; \
        url      = '${eclipse.simrel.baseurl}/${eclipse.simrel.version.2024-03}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.31}_simrel_${eclipse.simrel.version.2024-03}_p2.index.xml.gz'; \
        cache    = '${build}/cache/ecl_${eclipse.simrel.version.2024-03}'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.repo.2024-03.osgi: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse SimRel ${eclipse.platform.version.4.31}/${eclipse.simrel.version.2024-03} <OSGi>'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.31}_simrel_${eclipse.simrel.version.2024-03}_p2.index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.31}'

# OSGiRepository requires the P2Repository index to be created first.
# indexed=false selects P2Repository and creates the index from download.eclipse.org.
# indexed=true selects OSGiRepository and uses the generated *_p2.index.xml.gz.
indexed.ecl-2024-03 = true

# Exactly one repository is active, selected by indexed.
-plugin.eclipse.simrel_2024-03.p2: ${if;${indexed.ecl-2024-03};;${eclipse.repo.2024-03.p2}}
-plugin.eclipse.simrel_2024-03.osgi: ${if;${indexed.ecl-2024-03};${eclipse.repo.2024-03.osgi};}
