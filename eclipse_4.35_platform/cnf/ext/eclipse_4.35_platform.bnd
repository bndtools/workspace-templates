# Eclipse Platform Release repository
eclipse.platform.baseurl = https://download.eclipse.org/eclipse/updates

eclipse.platform.version.4.35 = 4.35
eclipse.platform.reltag.R-4.35-202502280140 = R-4.35-202502280140

# p2 repository: reads the p2 site directly; location is the generated index file.
eclipse.p2.repository.4.35: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name     = 'Eclipse P2 Platform ${eclipse.platform.version.4.35}'; \
        url      = '${eclipse.platform.baseurl}/${eclipse.platform.version.4.35}'; \
        location = '${.}/eclipse_${eclipse.platform.version.4.35}_platform_p2.index.xml.gz'

# Indexed OSGi repository: uses index.xml.gz inside the p2 index archive, cached under cnf/cache.
eclipse.osgi.repository.4.35: \
    aQute.bnd.repository.osgi.OSGiRepository; \
        name      = 'Eclipse Platform ${eclipse.platform.version.4.35}'; \
        locations = '${fileuri;${.}/eclipse_${eclipse.platform.version.4.35}_platform_p2.index.xml.gz/index.xml.gz}'; \
        cache     = '${build}/cache/ecl_${eclipse.platform.version.4.35}'

# Selects which repository type the eclipse_* file in this folder activates.
#   true  = OSGiRepository backed by the pre-generated *_p2.index.xml.gz (fast, no p2 metadata download)
#   false = P2Repository that reads the p2 site directly from download.eclipse.org
# The index is generated from the p2 repository (see 'location' in the eclipse_* file).
useIndexed = true

# Exactly one is active: p2 repository if useIndexed is false, OSGi indexed repository if true (see eclipse-repo-config.bnd).
-plugin.p2.eclipse.platform_4.35: ${if;${useIndexed};;${eclipse.p2.repository.4.35}}
-plugin.osgi.eclipse.platform_4.35: ${if;${useIndexed};${eclipse.osgi.repository.4.35};}
